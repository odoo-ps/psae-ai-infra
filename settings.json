{
  "permissions": {
    "deny": [
      "Edit(**/controllers/**)",
      "Edit(**/security/**)",
      "Edit(**/static/src/**)",
      "Edit(**/__manifest__.py)",
      "Edit(/home/odoo/src/odoo/**)",
      "Edit(/home/odoo/src/enterprise/**)",
      "Edit(/home/odoo/src/themes/**)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout staging:*)",
      "Bash(git checkout production:*)",
      "Bash(git switch staging:*)",
      "Bash(git switch production:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm ci:*)",
      "Bash(npm add:*)",
      "Bash(yarn add:*)",
      "Bash(yarn install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm install:*)",
      "Bash(odoo-bin scaffold:*)",
      "Bash(odoo-bin -d:*)",
      "Bash(odoo-bin --database:*)",
      "Bash(createdb:*)",
      "Bash(dropdb:*)"
    ],
    "ask": [
      "Edit(**/*.py)",
      "Edit(**/views/**)",
      "Edit(**/report/**)",
      "Edit(**/data/**)",
      "Bash(odoosh-push:*)",
      "Bash(odoo-bin -i:*)",
      "Bash(odoo-bin shell:*)"
    ],
    "allow": [
      "Edit(**/i18n/**)",
      "Edit(specifications/**)",
      "Edit(mocks/**)",
      "Edit(handovers/**)",
      "Edit(spreadsheet_reports/**)",
      "Edit(plans/**)",
      "Read(**)",
      "Bash(odoo-bin -u:*)",
      "Bash(odoo-bin --test-tags:*)",
      "Bash(psql:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(git config user.email:*)",
      "Bash(git config user.name:*)",
      "Bash(echo:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_change.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\""
          }
        ]
      }
    ]
  }
}
